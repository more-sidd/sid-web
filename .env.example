# Copy to .env and fill in from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# The anon key is designed to be public — it ships in the JS bundle. What keeps
# your data safe is Row Level Security in supabase/schema.sql, not this key.
# Never put the service_role key here.
#
# Leave these unset and the blog still works — only the comment box is disabled.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
